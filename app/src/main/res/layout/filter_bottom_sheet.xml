<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="30dp"
        android:gravity="center_vertical">

        <!-- Centered title -->
        <TextView
            android:id="@+id/textSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:layout_centerInParent="true"
            tools:ignore="RelativeOverlap" />

        <!-- Close button aligned right -->
        <ImageView
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cancel"
            android:background="@drawable/item_press_effect"
            android:src="@drawable/close"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>


    <!-- Reading Level Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reading_level"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:textColor="#666666"
        android:layout_marginBottom="12dp" />

    <GridLayout
        android:id="@+id/reading_level_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="2"
        android:layout_marginBottom="24dp">

    </GridLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="24dp" />

    <!-- Categories Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/categories"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:textColor="#666666"
        android:layout_marginBottom="12dp" />

    <GridLayout
        android:id="@+id/categories_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="4">

    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/clear"
            android:textColor="@color/black"
            android:backgroundTint="@color/filter_color"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false"
            android:textSize="16sp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btn_show_books"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/show_books"
            android:textColor="@color/black"
            android:backgroundTint="@color/filter_color"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false"
            android:textSize="16sp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>


</LinearLayout>
